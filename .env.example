# InsForge user-scoped auth; never put an admin API key in NEXT_PUBLIC variables.
NEXT_PUBLIC_INSFORGE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=
# Set the provisioned admin identity on the server, never derive it from profile metadata.
GLEANS_ADMIN_EMAIL=team@gleans.my.id
GLEANS_ADMIN_USER_ID=

# Local auth links must match InsForge allowed redirect URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
