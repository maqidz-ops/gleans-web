# InsForge user-scoped auth; never put an admin API key in NEXT_PUBLIC variables.
NEXT_PUBLIC_INSFORGE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=
# Set the provisioned admin identity on the server, never derive it from profile metadata.
GLEANS_ADMIN_EMAIL=team@gleans.my.id
GLEANS_ADMIN_USER_ID=

# Local auth links must match InsForge allowed redirect URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Duitku Sandbox: server-only credentials, never use NEXT_PUBLIC_ prefixes.
DUITKU_ENV=sandbox
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=

# InsForge admin key is used only on the server for verified payment writes.
INSFORGE_API_KEY=
# Public HTTPS origin for Duitku callbacks and return URLs; no trailing path.
DUITKU_PUBLIC_URL=https://www.gleans.my.id
