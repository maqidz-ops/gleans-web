{
  "name": "gleans-workspace",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --filter @gleans/web dev",
    "build": "pnpm --filter @gleans/web build",
    "start": "pnpm --filter @gleans/web start",
    "lint": "pnpm --filter @gleans/web lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm --filter @gleans/web test",
    "test:admin": "pnpm --filter @gleans/web test:admin",
    "test:dashboard": "pnpm --filter @gleans/web test:dashboard",
    "test:cite": "pnpm --filter @gleans/web test:cite",
    "test:file": "pnpm --filter @gleans/web test:file"
  }
}
